package components

import (
	"context"
	"database/sql"
	"fmt"
	"time"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/icons"
)

func tokenLabel(ctx context.Context, key, fallback string) string {
	if translated := i18n.T(ctx, key); translated != "" && translated != key {
		return translated
	}
	return fallback
}

func formatTokenTime(ts sql.NullTime, emptyLabel string) string {
	if !ts.Valid {
		return emptyLabel
	}
	return ts.Time.UTC().Format("2006-01-02 15:04 UTC")
}

func isTokenExpired(ts sql.NullTime) bool {
	return ts.Valid && !ts.Time.After(time.Now().UTC())
}

func showWriteScopeOption(user auth.User) bool {
	return !user.IsAuthenticated() || user.CanWrite()
}

func showAdminScopeOption(user auth.User) bool {
	return !user.IsAuthenticated() || user.IsAdmin()
}

templ APITokens(tokens []db.ListAPITokensByUserRow, newToken string) {
	{{ user := auth.GetUser(ctx) }}
	<div id="api-tokens-card" class="card bg-base-200 shadow-xl border border-base-300">
		<div class="card-body">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
				<div>
					<h3 class="font-bold text-sm uppercase tracking-wider opacity-50 flex items-center gap-2">
						@icons.Lock(templ.Attributes{"class": "w-5 h-5"})
						{ tokenLabel(ctx, "APITokens", "API Tokens") }
					</h3>
					<p class="text-xs opacity-70 mt-1">
						Create scoped Bearer tokens (<code>wlg_...</code>) for automated scripts, barcode clients, and Home Assistant integrations via <code>/api/v1</code>.
					</p>
				</div>
			</div>
			if newToken != "" {
				<div id="api-token-reveal" role="alert" class="alert alert-warning mb-6 flex-col items-stretch gap-3 shadow-md">
					<div class="flex items-start gap-2 font-medium text-sm">
						@icons.TriangleAlert(templ.Attributes{"class": "w-5 h-5 shrink-0 mt-0.5"})
						<span>{ tokenLabel(ctx, "TokenCreatedWarning", "Copy your new API token now. For security, it will not be shown again.") }</span>
					</div>
					<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-base-100/90 text-base-content p-3 rounded-lg border border-warning/40">
						<code class="font-mono text-xs sm:text-sm break-all flex-1 select-all">{ newToken }</code>
						<button
							type="button"
							class="btn btn-sm btn-neutral gap-1.5 shrink-0"
							data-token={ newToken }
							onclick="window.copyTextSafe(this.dataset.token).then(function(){ if (window.showToast) window.showToast('API token copied to clipboard', 'alert-success'); }).catch(function(){ if (window.showToast) window.showToast('Copy failed — please copy the token manually', 'alert-warning'); });"
						>
							@icons.Clipboard(templ.Attributes{"class": "w-4 h-4"})
							Copy
						</button>
					</div>
				</div>
			}
			<form
				action="/settings/tokens"
				method="POST"
				hx-post="/settings/tokens"
				hx-target="#api-tokens-card"
				hx-swap="outerHTML"
				class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 items-end mb-6 bg-base-100 p-4 rounded-lg border border-base-300"
			>
				<div class="form-control w-full">
					<label class="label py-1">
						<span class="label-text text-xs font-medium">{ i18n.T(ctx, "Name") }</span>
					</label>
					<input
						type="text"
						name="name"
						maxlength="100"
						required
						placeholder="e.g. Lab Script"
						class="input input-bordered input-sm w-full"
					/>
				</div>
				<div class="form-control w-full">
					<label class="label py-1">
						<span class="label-text text-xs font-medium">Scope</span>
					</label>
					<select name="scope" class="select select-bordered select-sm w-full">
						<option value="read">read</option>
						if showWriteScopeOption(user) {
							<option value="write">write</option>
						}
						if showAdminScopeOption(user) {
							<option value="admin">admin</option>
						}
					</select>
				</div>
				<div class="form-control w-full">
					<label class="label py-1">
						<span class="label-text text-xs font-medium">Expires (days, optional)</span>
					</label>
					<input
						type="number"
						name="expires_days"
						min="1"
						max="3650"
						placeholder="Never"
						class="input input-bordered input-sm w-full"
					/>
				</div>
				<div>
					<button type="submit" class="btn btn-primary btn-sm w-full gap-1.5 whitespace-nowrap">
						@icons.Plus(templ.Attributes{"class": "w-4 h-4"})
						{ tokenLabel(ctx, "CreateToken", "Create Token") }
					</button>
				</div>
			</form>
			if len(tokens) == 0 {
				<div class="text-sm opacity-60 bg-base-100 rounded-lg border border-base-300 p-4 text-center">
					No API tokens created yet.
				</div>
			} else {
				<div class="overflow-x-auto bg-base-100 rounded-lg border border-base-300">
					<table class="table table-sm w-full">
						<thead>
							<tr>
								<th>{ i18n.T(ctx, "Name") }</th>
								<th>Prefix</th>
								<th>Scopes</th>
								<th>Last Used</th>
								<th>Expires</th>
								<th class="text-right">{ i18n.T(ctx, "Actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, tok := range tokens {
								<tr class="hover">
									<td class="font-medium">{ tok.Name }</td>
									<td>
										<code class="text-xs font-mono bg-base-200 px-2 py-0.5 rounded">{ tok.TokenPrefix }…</code>
									</td>
									<td>
										<span class="badge badge-sm badge-outline font-mono">{ tok.Scopes }</span>
									</td>
									<td class="text-xs opacity-75">{ formatTokenTime(tok.LastUsedAt, "Never") }</td>
									<td class="text-xs opacity-75">
										{ formatTokenTime(tok.ExpiresAt, "Never") }
										if isTokenExpired(tok.ExpiresAt) {
											<span class="badge badge-xs badge-error ml-1 whitespace-nowrap">Expired</span>
										}
									</td>
									<td class="text-right whitespace-nowrap">
										<form
											action={ templ.SafeURL(fmt.Sprintf("/settings/tokens/%d/delete", tok.ID)) }
											method="POST"
											hx-post={ fmt.Sprintf("/settings/tokens/%d/delete", tok.ID) }
											hx-target="#api-tokens-card"
											hx-swap="outerHTML"
											hx-confirm="Revoke this API token? Existing clients using it will immediately lose access."
											data-confirm="Revoke this API token? Existing clients using it will immediately lose access."
											onsubmit="if (!window.htmx) return confirm(this.dataset.confirm);"
											class="inline-block shrink-0"
										>
											<button type="submit" class="btn btn-xs btn-outline btn-error gap-1 whitespace-nowrap">
												@icons.Trash(templ.Attributes{"class": "w-3.5 h-3.5"})
												{ tokenLabel(ctx, "RevokeToken", "Revoke") }
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
