package components

// BarcodeScannerModal renders the hidden dialog and the logic required for scanning.
// Place this ONCE at the bottom of your page or layout.
templ BarcodeScannerModal() {
	<dialog id="global_scanner_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box bg-base-100 p-0 relative overflow-hidden w-full sm:w-11/12 sm:max-w-md">
			<div class="bg-base-200/50 px-6 py-4 border-b border-base-200 flex justify-between items-center">
				<h3 class="font-bold text-lg flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
					Scan Barcode
				</h3>
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-primary" onclick="stopGlobalScanner()">✕</button>
				</form>
			</div>
			<div class="p-6 flex flex-col items-center bg-base-100">
				<p class="text-sm text-base-content/60 mb-4 text-center">
					Point your camera at the barcode.
				</p>
				<div class="w-full relative rounded-xl overflow-hidden border-2 border-dashed border-base-300 bg-base-200/30 min-h-[300px] flex justify-center items-center">
					<div id="reader" class="w-full h-full"></div>
				</div>
			</div>
			<div class="p-4 border-t border-base-200 flex justify-end">
				<button type="button" class="btn btn-ghost" onclick="stopGlobalScanner()">Cancel</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop bg-neutral/50">
			<button type="button" onclick="stopGlobalScanner()">close</button>
		</form>
	</dialog>
	<style>
        /* Hide the status text generated by the library */
        #reader__status_span { display: none !important; }
        
        /* Remove the 'powered by' link */
        #reader div[style*="font-size: 10pt"] { display: none !important; }

        /* Style the 'Request Permission' and 'Stop' buttons */
        #reader button {
            background-color: var(--fallback-p,oklch(var(--p)/1));
            color: var(--fallback-pc,oklch(var(--pc)/1));
            border-radius: var(--rounded-btn, 0.5rem);
            padding: 0 1rem;
            height: 2rem;
            min-height: 2rem;
            border: none;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.875rem;
            cursor: pointer;
            margin-top: 10px;
            transition: opacity 0.2s;
        }
        #reader button:hover {
            opacity: 0.9;
        }

        /* Style the camera selection dropdown */
        #reader select {
            background-color: var(--fallback-b1,oklch(var(--b1)/1));
            border: 1px solid var(--fallback-bc,oklch(var(--bc)/0.2));
            color: var(--fallback-bc,oklch(var(--bc)/1));
            border-radius: var(--rounded-btn, 0.5rem);
            padding: 0.25rem 1rem;
            height: 2rem;
            margin-bottom: 10px;
            max-width: 100%;
        }
        
        #reader { border: none !important; }
    </style>
	<script src="/static/js/barcode_scanner.js"></script>
}

// BarcodeTrigger renders the square scan button.
// targetID: The HTML 'id' of the input field you want to populate.
templ BarcodeTrigger(targetID string) {
	<button
		type="button"
		class="btn join-item btn-square btn-primary"
		title="Scan Barcode"
		{ templ.Attributes{"onclick": "startGlobalScanner('" + targetID + "')"}... }
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
	</button>
}
