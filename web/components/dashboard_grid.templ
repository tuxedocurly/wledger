package components

import (
	"fmt"
	"sort"
)

// DashboardBin represents a single cell on the dashboard
type DashboardBin struct {
	ID       int64    `json:"id"`
	Name     string   `json:"name"`
	GridX    int      `json:"grid_x"`
	GridY    int      `json:"grid_y"`
	Statuses []string `json:"statuses"` // "critical", "low", "ok", or empty
}

// DashboardController represents a controller and its grid of bins
type DashboardController struct {
	ID         int64                `json:"id"`
	Name       string               `json:"name"`
	Containers []DashboardContainer `json:"containers"`
}

// DashboardContainer represents a physical container displayed on a wall
type DashboardContainer struct {
	ID               int64          `json:"id"`
	Name             string         `json:"name"`
	SegmentID        int64          `json:"segment_id"`
	ControllerName   string         `json:"controller_name"`
	ControllerOnline bool           `json:"controller_online"`
	IsStandalone     bool           `json:"is_standalone"`
	Bins             []DashboardBin `json:"bins"`
}

type DashboardWall struct {
	ID          int64                `json:"id"`
	Name        string               `json:"name"`
	Description string               `json:"description"`
	Containers  []DashboardContainer `json:"containers"`
}

var stockColorVars = map[string]string{
	"critical": "var(--color-stock-critical)",
	"low":      "var(--color-stock-low)",
	"ok":       "var(--color-stock-ok)",
}

// GetStatusKeys returns the unique, sorted statuses for this bin
func (b DashboardBin) GetStatusKeys() []string {
	unique := make(map[string]bool)
	for _, s := range b.Statuses {
		if s != "" {
			unique[s] = true
		}
	}
	var keys []string
	for k := range unique {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

// GetClass returns base utility classes for bins (colors are applied dynamically via GetStyle CSS variables).
func (b DashboardBin) GetClass() string {
	keys := b.GetStatusKeys()

	if len(keys) == 0 {
		return "bg-base-200 border-base-300 text-base-content"
	}

	return "border-base-content/25 text-white"
}

// GetStyle returns positioning plus custom-property stock health colors/gradients so Settings pickers take effect live.
func (b DashboardBin) GetStyle() string {
	keys := b.GetStatusKeys()
	pos := fmt.Sprintf("grid-column: %d; grid-row: %d;", b.GridX+1, b.GridY+1)

	if len(keys) == 0 {
		return pos
	}

	if len(keys) == 1 {
		if colorVar, ok := stockColorVars[keys[0]]; ok {
			return fmt.Sprintf("%s background-color: %s;", pos, colorVar)
		}
		return pos
	}

	bgStyle := ""
	if len(keys) == 2 {
		c1 := stockColorVars[keys[0]]
		c2 := stockColorVars[keys[1]]
		bgStyle = fmt.Sprintf("background: linear-gradient(135deg, %s 50%%, %s 50%%);", c1, c2)
	} else if len(keys) >= 3 {
		c1 := stockColorVars[keys[0]]
		c2 := stockColorVars[keys[1]]
		c3 := stockColorVars[keys[2]]
		bgStyle = fmt.Sprintf("background: conic-gradient(%s 0deg 120deg, %s 120deg 240deg, %s 240deg 360deg);", c1, c2, c3)
	}

	return fmt.Sprintf("%s %s", pos, bgStyle)
}

templ DashboardGrid(ctrl DashboardController) {
	if len(ctrl.Containers) == 0 {
		<div class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<h2 class="font-bold text-sm uppercase tracking-wider opacity-50">{ ctrl.Name }</h2>
				<div class="badge badge-sm badge-ghost">Empty</div>
			</div>
			<div class="text-center py-8 opacity-50 border border-dashed border-base-300 rounded-lg">
				<p class="text-sm">No containers configured.</p>
			</div>
		</div>
	} else {
		<div class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<h2 class="font-bold text-sm uppercase tracking-wider">{ ctrl.Name }</h2>
				<div class="badge badge-sm badge-info rounded-full font-bold">{ fmt.Sprintf("%d Containers", len(ctrl.Containers)) }</div>
			</div>
			<div class="card bg-base-200 shadow-xl border border-base-300 overflow-hidden">
				<div class="card-body p-6 gap-6">
					for _, container := range ctrl.Containers {
						<div class="flex flex-col gap-2">
							<div class="flex items-center justify-between px-1">
								<div class="flex items-center gap-2">
									<h3 class="font-bold text-sm uppercase tracking-wider opacity-80">{ container.Name }</h3>
									if container.IsStandalone {
										<span class="badge badge-xs badge-ghost uppercase">Standalone</span>
									}
								</div>
								<div class="text-sm font-mono opacity-40">ID: { fmt.Sprintf("%d", container.ID) }</div>
							</div>
							<div class="overflow-x-auto bg-base-100 rounded-lg border border-base-300 p-4 shadow-sm">
								<div
									class="grid gap-1.5"
									style="width: fit-content; min-width: 100%;"
								>
									for _, bin := range container.Bins {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.ID)) }
											class={ "w-12 h-12 rounded-md border flex items-center justify-center text-xs font-bold shadow-sm hover:scale-110 hover:shadow-md hover:z-10 hover:border-base-content/60 transition-all duration-200 cursor-pointer " + bin.GetClass() }
											style={ bin.GetStyle() }
											title={ bin.Name }
										>
											if len(bin.GetStatusKeys()) > 0 {
												<span class="px-1.5 py-0.5 rounded bg-neutral/75 text-white text-[11px] font-bold leading-none shadow-sm">{ bin.Name }</span>
											} else {
												<span>{ bin.Name }</span>
											}
										</a>
									}
								</div>
							</div>
						</div>
					}
					<div class="flex justify-end mt-2 pt-4 border-t border-base-content/5">
						<div class="flex gap-4 px-4 py-2 rounded-full border border-base-300 shadow-sm text-xs font-bold uppercase tracking-wider">
							<div class="flex flex-row items-center gap-2"><div class="w-2.5 h-2.5 rounded-full border border-base-content/20" style="background-color: var(--color-stock-ok);"></div>OK</div>
							<div class="flex flex-row items-center gap-2"><div class="w-2.5 h-2.5 rounded-full border border-base-content/20" style="background-color: var(--color-stock-low);"></div>Low</div>
							<div class="flex flex-row items-center gap-2"><div class="w-2.5 h-2.5 rounded-full border border-base-content/20" style="background-color: var(--color-stock-critical);"></div>Critical</div>
							<div class="flex flex-row items-center gap-2"><div class="w-2.5 h-2.5 rounded-full bg-base-200 border border-base-300"></div>Empty</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
