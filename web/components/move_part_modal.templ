package components

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/db"
)

// ControllerSelectOptions renders controller dropdown options, including a
// standalone container group option when standalone containers exist.
templ ControllerSelectOptions(controllers []db.Controller, hasStandalone bool, placeholder string) {
	<option value="" disabled selected>{ placeholder }</option>
	for _, c := range controllers {
		<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
	}
	if hasStandalone {
		<option value="standalone">Standalone Containers</option>
	}
}

// MoveStockModal renders a reusable modal for moving or fixing stock assignments.
// It handles the Controller (or Standalone) + Bin selection logic for "move" and "fix" part buttons on part_detail.templ.
templ MoveStockModal(modalID string, title string, message string, actionURL string, quantity int64, controllers []db.Controller, hasStandalone ...bool) {
	@Modal(ModalProps{
		ID:         modalID,
		Title:      title,
		TitleClass: "text-warning",
		BoxClass:   "max-w-2xl",
	}) {
		<p class="text-sm opacity-70 mb-6">
			{ message }
		</p>
		<div x-data="{ hasSelection: false }">
			<form
				id={ fmt.Sprintf("%s_form", modalID) }
				action={ templ.SafeURL(actionURL) }
				method="POST"
				class="space-y-6"
			>
				<div class="form-control w-full">
					<label class="label pt-0 pb-2 justify-start gap-2">
						<span class="label-text font-bold text-xs uppercase tracking-widest">1. Select Target Controller or Standalone</span>
					</label>
					<select
						name="controller_id"
						class="select select-bordered w-full"
						hx-get="/parts/bin_picker"
						hx-target={ fmt.Sprintf("#%s_visual_bin_picker", modalID) }
						hx-trigger="change"
						required
						@change="hasSelection = false"
					>
						@ControllerSelectOptions(controllers, len(hasStandalone) > 0 && hasStandalone[0], "Select...")
					</select>
				</div>

				<div class="form-control w-full">
					<label class="label pt-0 pb-2 justify-start gap-2">
						<span class="label-text font-bold text-xs uppercase tracking-widest">2. Choose New Physical Bin</span>
					</label>
					<div 
						id={ fmt.Sprintf("%s_visual_bin_picker", modalID) }
						class="min-h-[200px] flex items-center justify-center border-2 border-dashed border-base-300 rounded-xl bg-base-200/30"
						@bin-selected-form="hasSelection = true"
					>
						<div class="text-center opacity-40 py-8">
							<p class="text-sm">Select a controller above to see available bins</p>
						</div>
					</div>
				</div>
			</form>

			<div class="modal-action border-t border-base-200 pt-6 mt-8">
				<form method="dialog">
					<button class="btn btn-ghost">Cancel</button>
				</form>
				<button 
					form={ fmt.Sprintf("%s_form", modalID) }
					type="submit"
					class="btn btn-primary px-8" 
					:disabled="!hasSelection"
				>
					Move Stock
				</button>
			</div>
		</div>
	}
}
