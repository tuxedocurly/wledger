package components

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/icons"
)

// PartForm renders the shared form for Creating and Editing parts.
// - part: The existing part data (empty if creating)
// - tags: Current tags for the part
// - allTags: All existing tags for suggestions
// - links: Existing links (empty if creating)
// - docs: Existing documents (empty if creating)
// - action: The URL to POST to (e.g., "/parts" or "/parts/1/update")
// - isEdit: Boolean to toggle specific "Edit Mode" features like deleting existing files
templ PartForm(part db.Part, tags []db.Tag, allTags []db.Tag, links []db.PartLink, docs []db.PartDoc, action string, isEdit bool) {
	<form
		action={ templ.SafeURL(action) }
		method="POST"
		enctype="multipart/form-data"
		class="space-y-8"
		x-data="partLinksForm"
	>
		<div class="card bg-base-200 shadow-sm border border-base-300">
			<div class="card-body p-6">
				<h3 class="card-title text-sm opacity-50 uppercase tracking-widest mb-4">{ i18n.T(ctx, "CoreDetails") }</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div class="form-control w-full">
						<label class="label pt-0 pb-2"><span class="label-text font-medium">{ i18n.T(ctx, "PartName") }</span></label>
						<input type="text" name="name" value={ part.Name } placeholder="e.g. ESP32-WROOM-32" class="input input-bordered w-full" required/>
					</div>
					@TagInput(tags, allTags)
					<div class="form-control w-full md:col-span-2">
						<label class="label pt-0 pb-2"><span class="label-text font-medium">{ i18n.T(ctx, "Description") }</span></label>
						<textarea
							name="description"
							class="textarea textarea-bordered h-24 text-base leading-relaxed resize-y w-full"
							placeholder={ i18n.T(ctx, "EnterDescriptionPlaceholder") }
						>{ part.Description.String }</textarea>
					</div>
					<div class="form-control w-full md:col-span-2">
						<label class="label pt-0 pb-2"><span class="label-text font-medium">{ i18n.T(ctx, "CoverImage") }</span></label>
						<div class="flex items-center gap-4">
							if isEdit && part.ImagePath.Valid {
								<div class="avatar">
									<div class="w-16 h-16 rounded border border-base-300">
										<img src={ part.ImagePath.String } alt={ i18n.T(ctx, "CurrentCoverImage") } class="object-cover w-full h-full"/>
									</div>
								</div>
							}
							<input type="file" name="image" accept="image/*" class="file-input file-input-bordered file-input-primary w-full"/>
						</div>
						<label class="label mt-2"><span class="label-text-alt opacity-60">{ i18n.T(ctx, "ReplaceImageNote") }</span></label>
					</div>
				</div>
			</div>
		</div>
		<div class="card bg-base-200 shadow-sm border border-base-300">
			<div class="card-body p-6">
				<h3 class="card-title text-sm opacity-50 uppercase tracking-widest mb-4">{ i18n.T(ctx, "SpecificationsAndSourcing") }</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="form-control w-full">
						<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "PartNumberMPN") }</span></label>
						<input type="text" name="part_number" value={ part.PartNumber.String } placeholder="e.g. SN74HC595N" class="input input-bordered w-full font-mono"/>
					</div>
					<div class="form-control w-full">
						<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "Manufacturer") }</span></label>
						<input type="text" name="manufacturer" value={ part.Manufacturer.String } placeholder="e.g. Texas Instruments" class="input input-bordered w-full"/>
					</div>
					<div class="form-control w-full">
						<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "Supplier") }</span></label>
						<input type="text" name="supplier" value={ part.Supplier.String } placeholder="e.g. DigiKey" class="input input-bordered w-full"/>
					</div>
					<div class="form-control w-full md:col-span-3">
						<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "Barcode") }</span></label>
						<div class="join w-full">
							<input
								id="barcode_input"
								type="text"
								name="barcode_data"
								value={ part.BarcodeData.String }
								placeholder={ i18n.T(ctx, "ScanBarcodePlaceholder") }
								class="input input-bordered join-item w-full font-mono"
							/>
							@BarcodeTrigger("barcode_input")
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="card bg-base-200 shadow-sm border border-base-300">
			<div class="card-body p-6">
				<h3 class="card-title text-sm opacity-50 uppercase tracking-widest mb-4">{ i18n.T(ctx, "InventoryControl") }</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="form-control w-full">
						<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "UnitCostLabel") }</span></label>
						<input type="number" step="0.01" name="unit_cost" value={ fmt.Sprintf("%.2f", part.UnitCost.Float64) } class="input input-bordered w-full"/>
					</div>
					<div class="form-control w-full">
						<label class="label mb-2">
							<span class="label-text font-medium">{ i18n.T(ctx, "MinStockLevel") }</span>
							@QuestionTooltip(i18n.T(ctx, "MinStockTooltip"))
						</label>
						<input type="number" name="min_stock" value={ fmt.Sprintf("%d", part.MinStockThreshold.Int64) } class="input input-bordered w-full"/>
					</div>
					<div class="form-control w-full">
						<label class="label mb-2">
							<span class="label-text font-medium">{ i18n.T(ctx, "ReorderLevelLabel") }</span>
							@QuestionTooltip(i18n.T(ctx, "ReorderLevelTooltip"))
						</label>
						<input type="number" name="reorder_level" value={ fmt.Sprintf("%d", part.ReorderLevel.Int64) } class="input input-bordered w-full"/>
					</div>
				</div>
			</div>
		</div>
		<div class="card bg-base-200 shadow-sm border border-base-300">
			<div class="card-body p-6">
				<h3 class="card-title text-sm opacity-50 uppercase tracking-widest mb-4">{ i18n.T(ctx, "Resources") }</h3>
				<div class="mb-6">
					<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "ExternalLinks") }</span></label>
					if isEdit {
						<div class="space-y-2 mb-2">
							for _, link := range links {
								<div class="flex gap-2" id={ fmt.Sprintf("link-%d", link.ID) }>
									<input type="hidden" name="existing_link_ids[]" value={ fmt.Sprintf("%d", link.ID) }/>
									<input
										type="text"
										name="existing_link_labels[]"
										value={ link.Label.String }
										class="input input-bordered w-1/3 text-sm"
										placeholder={ i18n.T(ctx, "Label") }
										required
									/>
									<input
										type="url"
										name="existing_link_urls[]"
										value={ link.Url }
										class="input input-bordered w-2/3 text-sm"
										placeholder={ i18n.T(ctx, "URL") }
										required
									/>
									<button
										type="button"
										class="btn btn-square btn-ghost text-error"
										hx-delete={ fmt.Sprintf("/parts/links/%d", link.ID) }
										hx-target={ fmt.Sprintf("#link-%d", link.ID) }
										hx-swap="outerHTML"
									>
										@icons.Trash(templ.Attributes{"class": "w-5 h-5"})
									</button>
								</div>
							}
						</div>
					}
					<div class="space-y-2">
						<template x-for="(link, index) in newLinks" :key="index">
							<div class="flex gap-2">
								<input type="text" name="link_labels[]" x-model="link.label" placeholder={ i18n.T(ctx, "LinkLabelPlaceholder") } class="input input-bordered w-1/3" required/>
								<input type="url" name="link_urls[]" x-model="link.url" placeholder="https://..." class="input input-bordered w-2/3" required/>
								<button type="button" @click="removeLink(index)" class="btn btn-square btn-ghost text-error">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
								</button>
							</div>
						</template>
					</div>
					<button type="button" @click="addLink()" class="btn btn-s btn-primary gap-2 mt-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
						{ i18n.T(ctx, "AddLink") }
					</button>
				</div>
				<div class="divider"></div>
				<div>
					<label class="label"><span class="label-text font-medium mb-2">{ i18n.T(ctx, "Documents") }</span></label>
					if isEdit && len(docs) > 0 {
						<div class="grid grid-cols-1 gap-2 mb-4">
							for _, doc := range docs {
								<div class="alert bg-base-100 border border-base-300 py-2 flex justify-between" id={ fmt.Sprintf("doc-%d", doc.ID) }>
									<div class="flex items-center gap-3 overflow-hidden">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
										<span class="text-sm truncate">{ doc.FileName }</span>
									</div>
									<button
										type="button"
										class="btn btn-s btn-error"
										hx-delete={ fmt.Sprintf("/parts/docs/%d", doc.ID) }
										hx-target={ fmt.Sprintf("#doc-%d", doc.ID) }
										hx-swap="outerHTML"
									>
										{ i18n.T(ctx, "Delete") }
									</button>
								</div>
							}
						</div>
					}
					<input type="file" name="documents" multiple class="file-input file-input-primary w-full"/>
				</div>
			</div>
		</div>
		<div class="flex justify-end gap-4 pt-4 pb-12">
			<a href="/parts" class="btn btn-ghost">{ i18n.T(ctx, "Cancel") }</a>
			<button type="submit" class="btn btn-primary px-8">
				if isEdit {
					{ i18n.T(ctx, "SaveChanges") }
				} else {
					{ i18n.T(ctx, "CreatePart") }
				}
			</button>
		</div>
	</form>
	<script src="/static/js/part_form.js"></script>
	@BarcodeScannerModal()
}

templ BinOptions(bins []db.Bin) {
	<option value="" disabled selected>{ i18n.T(ctx, "SelectABin") }</option>
	for _, b := range bins {
		<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name }</option>
	}
}