package components

import (
	"fmt"
	"github.com/tuxedocurly/wledger/web/icons"
)

templ PartLocateButton(partID int64, className string) {
	<button
		hx-post={ fmt.Sprintf("/parts/%d/locate", partID) }
		hx-swap="none"
		class={ "btn btn-outline text-accent z-10", className }
		title="Locate all assignments"
		onclick="event.stopPropagation()"
	>
		@icons.Eye(templ.Attributes{"class": "w-5 h-5"})
	</button>
}