package components

import "github.com/tuxedocurly/wledger/web/icons"
import "github.com/tuxedocurly/wledger/internal/i18n"

// PartSearchFilters holds active list filter parameters preserved across searches.
type PartSearchFilters struct {
	Tag          string
	Bin          string
	BinID        string
	ControllerID string
	Stock        string
	Sort         string
}

func firstSearchFilters(filters ...PartSearchFilters) PartSearchFilters {
	if len(filters) > 0 {
		return filters[0]
	}
	return PartSearchFilters{}
}

// PartSearchBar renders the search input and 'Add Part' button.
// It handles responsive layout (stacking on mobile, row on desktop) and preserves
// active filter parameters during search submissions.
templ PartSearchBar(search string, canWrite bool, filters ...PartSearchFilters) {
	{{ f := firstSearchFilters(filters...) }}
	<div class="flex flex-col md:flex-row gap-3 w-full md:w-auto">
		<form id="part-search-form" action="/parts" method="GET" class="join w-full md:w-auto shadow-sm">
			if f.Tag != "" {
				<input type="hidden" name="tag" value={ f.Tag }/>
			}
			if f.Bin != "" {
				<input type="hidden" name="bin" value={ f.Bin }/>
			}
			if f.BinID != "" {
				<input type="hidden" name="bin_id" value={ f.BinID }/>
			}
			if f.ControllerID != "" {
				<input type="hidden" name="controller_id" value={ f.ControllerID }/>
			}
			if f.Stock != "" {
				<input type="hidden" name="stock" value={ f.Stock }/>
			}
			if f.Sort != "" {
				<input type="hidden" name="sort" value={ f.Sort }/>
			}
			<input
				type="search"
				name="q"
				value={ search }
				class="input input-bordered join-item w-full rounded-full md:w-64"
				placeholder={ i18n.T(ctx, "SearchPartsPlaceholder") }
				hx-get="/parts"
				hx-trigger="input changed delay:250ms, search"
				hx-include="closest form"
				hx-target="#parts-grid"
				hx-select="#parts-grid"
				hx-swap="outerHTML"
				hx-push-url="true"
			/>
		</form>
		if canWrite {
			<div class="flex gap-2 w-full md:w-auto">
				<button onclick="import_parts_modal.showModal()" class="btn btn-outline flex-1 md:flex-none shadow-sm" title={ i18n.T(ctx, "BulkImport") }>
					@icons.Import(templ.Attributes{"class": "w-5 h-5"})
					{ i18n.T(ctx, "Import") }
				</button>
				<a href="/parts/new" class="btn btn-primary flex-1 md:flex-none shadow-sm gap-2">
					@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
					{ i18n.T(ctx, "AddPart") }
				</a>
			</div>
		}
	</div>
}
