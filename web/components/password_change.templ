package components

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/i18n"
)

templ ChangePasswordForm(actionURL string, showCurrentPassword bool) {
	<form action={ templ.SafeURL(actionURL) } method="POST" class="space-y-6 max-w-md">
		if showCurrentPassword {
			<div class="form-control">
				<label class="label"><span class="label-text">{ i18n.T(ctx, "CurrentPassword") }</span></label>
				<input type="password" name="current_password" class="input input-bordered w-full" required/>
			</div>
		}
		<div class="form-control">
			<label class="label"><span class="label-text">{ i18n.T(ctx, "NewPassword") }</span></label>
			<input
				type="password"
				name="new_password"
				id="new_password"
				class="input input-bordered w-full validator"
				required
				minlength="8"
				placeholder="••••••••"
				pattern=".{8,}"
				title={ i18n.T(ctx, "PasswordMinLength") }
			/>
			<p class="validator-hint text-xs text-error mt-1">{ i18n.T(ctx, "PasswordMinLength") }</p>
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">{ i18n.T(ctx, "ConfirmNewPassword") }</span></label>
			<input
				type="password"
				name="confirm_password"
				class="input input-bordered w-full validator"
				required
				minlength="8"
				placeholder={ i18n.T(ctx, "ReEnterPassword") }
				{ templ.Attributes{"oninput": fmt.Sprintf("this.setCustomValidity(this.value != document.getElementById('new_password').value ? '%s' : '')", i18n.T(ctx, "PasswordsDoNotMatch"))}... }
			/>
			<p class="validator-hint text-xs text-error mt-1">{ i18n.T(ctx, "PasswordsDoNotMatch") }</p>
		</div>
		<div class="pt-4">
			<button class="btn btn-primary w-full">{ i18n.T(ctx, "UpdatePassword") }</button>
		</div>
	</form>
}
