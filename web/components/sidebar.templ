package components

import "github.com/tuxedocurly/wledger/internal/auth"
import "github.com/tuxedocurly/wledger/internal/i18n"
import "github.com/tuxedocurly/wledger/web/icons"

templ Sidebar(user auth.User) {
	<aside class="bg-base-200 w-80 h-full flex flex-col border-r border-base-300">
		<!-- Sidebar Header -->
		<div class="flex flex-col shrink-0">
			<a href="/" class="flex items-center justify-center h-16 shrink-0 hover:bg-base-300 transition-colors px-4">
				<img src="/static/img/wledger-name-rainbow.png" alt="WLEDger" class="h-8 w-auto object-contain"/>
			</a>
			<div class="px-6 pb-4 border-b border-base-300/50 mb-2">
				if user.IsAuthenticated() {
					<div class="flex flex-col">
						<span class="text-sm font-semibold truncate">{ user.Email }</span>
						<span class="text-xs opacity-50 uppercase tracking-wider font-mono mt-0.5">{ i18n.T(ctx, user.Role) }</span>
					</div>
				} else {
					<span class="text-xs opacity-50 uppercase tracking-wider font-mono mt-0.5">{ i18n.T(ctx, "GuestAccess") }</span>
				}
			</div>
		</div>
		<!-- Search -->
		<div class="px-4 mb-2 shrink-0">
			<div class="relative">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 opacity-50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
				<input
					type="text"
					name="q"
					placeholder={ i18n.T(ctx, "SearchPlaceholder") }
					class="input input-sm input-bordered w-full pl-9 h-10"
					@keydown.window.meta.k.prevent="$el.focus()"
					@keydown.window.ctrl.k.prevent="$el.focus()"
					hx-get="/parts"
					hx-trigger="input changed delay:500ms, search"
					hx-target="#main-content"
					hx-select="#main-content"
					hx-swap="outerHTML"
					hx-push-url="true"
				/>
			</div>
		</div>
		<!-- Sidebar Menu -->
		<ul class="menu flex-nowrap flex-1 px-4 py-2 overflow-y-auto custom-scrollbar gap-1">
			@NavLinks(user)
			@CommunityLinks()
		</ul>
		<!-- Sidebar Footer -->
		<div class="p-4 border-t border-base-300 bg-base-200/50 space-y-2 shrink-0">
			@LanguageSwitcher()
			@ThemeToggle()
			if user.IsAuthenticated() {
				@LogoutButton()
			} else {
				@LoginButton()
			}
			@GlobalOffButton()
		</div>
	</aside>
}

// -----------------------------------------------------------
// REUSABLE COMPONENTS
// -----------------------------------------------------------
templ LanguageSwitcher() {
	<div class="dropdown dropdown-top w-full">
		<div tabindex="0" role="button" class="btn btn-ghost justify-start w-full normal-case text-base font-normal px-2 gap-2">
			@icons.Languages(templ.Attributes{"class": "w-5 h-5"})
			<span>{ i18n.T(ctx, i18n.GetLanguage(ctx)) }</span>
		</div>
		<ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-full mb-2">
			<li><a href="?lang=en">{ i18n.T(ctx, "English") }</a></li>
			<li><a href="?lang=es">{ i18n.T(ctx, "Spanish") }</a></li>
		</ul>
	</div>
}

templ GlobalOffButton() {
	<button
		hx-post="/hardware/off"
		hx-swap="none"
		class="btn btn-outline btn-error w-full gap-2 justify-start normal-case text-base font-normal px-2"
	>
		@icons.Power(templ.Attributes{"class": "w-5 h-5"})
		{ i18n.T(ctx, "TurnOffAllLEDs") }
	</button>
}

templ LogoutButton() {
	<form action="/logout" method="POST" class="w-full">
		<button type="submit" class="btn btn-ghost justify-start w-full normal-case text-base font-normal px-2 text-error hover:bg-error/10">
			@icons.LogOut(templ.Attributes{"class": "w-5 h-5"})
			{ i18n.T(ctx, "LogOut") }
		</button>
	</form>
}

templ LoginButton() {
	<a href="/login" class="btn btn-ghost justify-start w-full normal-case text-base font-normal px-2 text-primary hover:text-primary">
		@icons.LogIn(templ.Attributes{"class": "w-5 h-5"})
		{ i18n.T(ctx, "LogIn") }
	</a>
}

templ ThemeToggle() {
	<label
		class="btn btn-ghost justify-start w-full normal-case text-base font-normal px-2 swap"
		x-data="themeToggle"
		:class="{ 'swap-rotate': isAnimating }"
	>
		<input type="checkbox" :checked="theme === 'silk'" @change="toggle()"/>
		<div class="swap-on flex items-center w-full">
			@icons.Sun(templ.Attributes{"class": "w-5 h-5"})
			<span>{ i18n.T(ctx, "SilkMode") }</span>
		</div>
		<div class="swap-off flex items-center w-full">
			@icons.Moon(templ.Attributes{"class": "w-5 h-5"})
			<span>{ i18n.T(ctx, "DarkMode") }</span>
		</div>
	</label>
}

templ CommunityLinks() {
	<li class="menu-title text-[12px] font-bold opacity-80 uppercase tracking-wider mt-4">{ i18n.T(ctx, "Community") }</li>
	<li>
		<a href="https://github.com/tuxedocurly/wledger/issues/new" target="_blank" class="text-base-content/70">
			@icons.Github(templ.Attributes{"class": "w-5 h-5"})
			<span class="ml-3">
				{ i18n.T(ctx, "Feedback") }
			</span>
		</a>
	</li>
	<li>
		<a href="https://discord.gg/HABg37gjrd" target="_blank" class="text-base-content/70">
			@icons.Discord(templ.Attributes{"class": "w-5 h-5"})
			<span class="ml-3">
				{ i18n.T(ctx, "JoinDiscord") }
			</span>
		</a>
	</li>
	<li>
		<a href="https://ko-fi.com/tuxedomakes" target="_blank" class="text-base-content/70">
			<span class="text-[#ff5e5b]">
				@icons.Kofi(templ.Attributes{"class": "w-5 h-5"})
			</span>
			<span class="ml-3">
				{ i18n.T(ctx, "SupportOnKofi") }
			</span>
		</a>
	</li>
}

templ NavLinks(user auth.User) {
	<li>
		<a href="/">
			@icons.LayoutGrid(templ.Attributes{"class": "w-5 h-5"})
			<span class="ml-3">
				{ i18n.T(ctx, "Dashboard") }
			</span>
		</a>
	</li>
	<li>
		<a href="/parts">
			@icons.Box(templ.Attributes{"class": "w-5 h-5"})
			<span class="ml-3">
				{ i18n.T(ctx, "Inventory") }
			</span>
		</a>
	</li>
	<li>
		<a href="/inspiration">
			@icons.Lightbulb(templ.Attributes{"class": "w-5 h-5"})
			<span class="ml-3">
				{ i18n.T(ctx, "Inspiration") }
			</span>
		</a>
	</li>
	if user.CanConfigure() {
		<li class="menu-title opacity-50 my-1 p-0 h-px bg-base-300"></li>
		<li>
			<a href="/hardware" hx-boost="false">
				@icons.Microchip(templ.Attributes{"class": "w-5 h-5"})
				<span class="ml-3">
					{ i18n.T(ctx, "Hardware") }
				</span>
			</a>
		</li>
		<li>
			<a href="/audit-logs">
				@icons.Clipboard(templ.Attributes{"class": "w-5 h-5"})
				<span class="ml-3">
					{ i18n.T(ctx, "AuditLogs") }
				</span>
			</a>
		</li>
		<li>
			<a href="/settings">
				@icons.Settings(templ.Attributes{"class": "w-5 h-5"})
				<span class="ml-3">
					{ i18n.T(ctx, "Settings") }
				</span>
			</a>
		</li>
	}
}