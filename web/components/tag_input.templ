package components

import (
	"github.com/tuxedocurly/wledger/internal/db"
)

// TagInput renders a multi-tag input component using Alpine.js and daisyUI.
// tags: Current tags for the part
// allTags: All existing tags in the system for autocomplete suggestions
templ TagInput(currentTags []db.Tag, allTags []db.Tag) {
	@templ.JSONScript("tag-input-data", getTagNames(currentTags))
	<div
		class="form-control w-full"
		x-data="tagInput('tag-input-data')"
	>
		<label class="label pt-0 pb-2">
			<span class="label-text font-medium">Tags</span>
		</label>
		<div class="flex flex-wrap gap-2 p-2 border border-base-300 rounded-lg bg-base-100 min-h-12 focus-within:border-primary transition-colors">
			<template x-for="(tag, index) in tags" :key="index">
				<div class="badge badge-primary badge-soft gap-1 py-3 px-3">
					<span x-text="tag" class="text-sm font-medium"></span>
					<button
						type="button"
						@click="removeTag(index)"
						class="btn btn-ghost btn-xs btn-circle hover:bg-primary-focus p-0 min-h-0 h-4 w-4"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</template>
			<input
				type="text"
				placeholder="Add tag and press Enter..."
				class="bg-transparent border-none outline-none flex-grow min-w-32 text-sm px-2 py-1"
				x-model="inputValue"
				@keydown.enter.prevent="addTag()"
				list="tag-suggestions"
			/>
		</div>
		<input type="hidden" name="tags" x-ref="hiddenInput" :value="tags.join(',')"/>
		<datalist id="tag-suggestions">
			for _, t := range allTags {
				<option value={ t.Name }></option>
			}
		</datalist>
		<label class="label mt-1">
			<span class="label-text-alt opacity-60">Separate tags with commas or press Enter.</span>
		</label>
	</div>
	<script src="/static/js/tag_input.js"></script>
}

func getTagNames(tags []db.Tag) []string {
	names := make([]string, len(tags))
	for i, t := range tags {
		names[i] = t.Name
	}
	return names
}
