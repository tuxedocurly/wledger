package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
	"net/url"
)

script openAuditDetail(id int64, oldVal string, newVal string) {
    console.log("Detail for", id, oldVal, newVal);
    window.dispatchEvent(new CustomEvent('open-audit-detail', { 
        detail: { id, oldVal, newVal } 
    }));
}

templ AuditLogs(user auth.User, logs []db.ListAuditLogsRow, users []db.ListUsersRow, filters db.ListAuditLogsParams, totalCount int64, currentPage int) {
	@layouts.Base("Audit Logs", user) {
		<div class="max-w-7xl mx-auto w-full px-4">
			@components.PageHeader("Audit Logs", "Monitor system activity and changes.", nil)
			<!-- Filters -->
			<div class="card bg-base-200 shadow-sm border border-base-300 mb-6">
				<div class="card-body p-4">
					<form action="/audit-logs" method="GET" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 items-end">
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">Search</span>
							</label>
							<input type="text" name="search" value={ filters.Search.String } class="input input-bordered input-md w-full" placeholder="Search details..."/>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">Action</span>
							</label>
							<select name="action_type" class="select select-bordered select-md w-full">
								<option value="">All Actions</option>
								<option value="CREATE" selected?={ filters.ActionType.String == "CREATE" }>CREATE</option>
								<option value="UPDATE" selected?={ filters.ActionType.String == "UPDATE" }>UPDATE</option>
								<option value="DELETE" selected?={ filters.ActionType.String == "DELETE" }>DELETE</option>
								<option value="ADJUST_STOCK" selected?={ filters.ActionType.String == "ADJUST_STOCK" }>ADJUST_STOCK</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">User</span>
							</label>
							<select name="user_id" class="select select-bordered select-md w-full">
								<option value="">All Users</option>
								for _, u := range users {
									<option value={ fmt.Sprintf("%d", u.ID) } selected?={ filters.UserID.Valid && filters.UserID.Int64 == u.ID }>{ u.Email }</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">Entity</span>
							</label>
							<select name="entity_type" class="select select-bordered select-md w-full">
								<option value="">All Entities</option>
								<option value="PART" selected?={ filters.EntityType.String == "PART" }>PART</option>
								<option value="BIN" selected?={ filters.EntityType.String == "BIN" }>BIN</option>
								<option value="CONTROLLER" selected?={ filters.EntityType.String == "CONTROLLER" }>CONTROLLER</option>
								<option value="USER" selected?={ filters.EntityType.String == "USER" }>USER</option>
								<option value="SETTINGS" selected?={ filters.EntityType.String == "SETTINGS" }>SETTINGS</option>
							</select>
						</div>
						<div class="flex gap-2 lg:col-span-2">
							<button type="submit" class="btn btn-primary btn-md flex-1">Filter</button>
							<a href="/audit-logs" class="btn btn-outline btn-primary btn-md">Reset</a>
						</div>
					</form>
				</div>
			</div>
			<!-- Logs Table -->
			<div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden">
				<div class="overflow-x-auto">
					<table class="table table-zebra w-full">
						<thead>
							<tr class="bg-base-200">
								<th>Timestamp</th>
								<th>User</th>
								<th>Action</th>
								<th>Entity</th>
								<th>Details</th>
								<th class="text-right">Data</th>
							</tr>
						</thead>
						<tbody id="audit-logs-table-body">
							@AuditLogRows(logs, filters, currentPage)
						</tbody>
					</table>
				</div>
			</div>
			<!-- Infinite Scroll Sentinel is inside AuditLogRows -->
		</div>
		@components.AuditDetailModal()
	}
}

templ AuditLogRows(logs []db.ListAuditLogsRow, filters db.ListAuditLogsParams, currentPage int) {
	for _, log := range logs {
		<tr class="hover">
			<td class="text-xs whitespace-nowrap">
				if log.CreatedAt.Valid {
					{ log.CreatedAt.Time.Format("2006-01-02 15:04:05") }
				}
			</td>
			<td>
				<div class="flex flex-col">
					<span class="text-sm font-medium">{ log.UserEmail.String }</span>
				</div>
			</td>
			<td>
				<span class={ "badge badge-sm font-mono " + getActionBadgeClass(log.ActionType) }>
					{ log.ActionType }
				</span>
			</td>
			<td>
				<div class="flex flex-col text-xs">
					<span class="opacity-50">{ log.EntityType }</span>
					<span class="font-mono">ID: { fmt.Sprintf("%d", log.EntityID) }</span>
				</div>
			</td>
			<td class="max-w-xs truncate text-sm">
				{ log.Details.String }
			</td>
			<td class="text-right">
				<button
					class="btn btn-ghost btn-xs"
					onclick={ openAuditDetail(log.ID, string(log.OldValue), string(log.NewValue)) }
				>
					@icons.Eye(templ.Attributes{"class": "w-5 h-5"})
					View
				</button>
			</td>
		</tr>
	}
	if len(logs) == 0 && currentPage == 1 {
		<tr>
			<td colspan="6" class="text-center py-12 opacity-50">
				No audit logs found matching your filters.
			</td>
		</tr>
	}
	// Sentinel for infinite scroll
	// If we got a full batch (20), assume there might be more
	if len(logs) >= 20 {
		<tr
			hx-get={ templ.SafeURL(fmt.Sprintf("/audit-logs?page=%d&scroll=true&%s", currentPage+1, getFilterQuery(filters))) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
		>
			<td colspan="6" class="text-center py-4">
				<span class="loading loading-dots loading-md opacity-50"></span>
			</td>
		</tr>
	}
}

func getActionBadgeClass(action string) string {
	switch action {
	case "CREATE":
		return "badge-success"
	case "UPDATE":
		return "badge-info"
	case "DELETE":
		return "badge-error"
	case "ADJUST_STOCK":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}

func getFilterQuery(f db.ListAuditLogsParams) string {
	v := url.Values{}
	if f.ActionType.Valid && f.ActionType.String != "" {
		v.Set("action_type", f.ActionType.String)
	}
	if f.EntityType.Valid && f.EntityType.String != "" {
		v.Set("entity_type", f.EntityType.String)
	}
	if f.UserID.Valid {
		v.Set("user_id", fmt.Sprintf("%d", f.UserID.Int64))
	}
	if f.Search.Valid && f.Search.String != "" {
		v.Set("search", f.Search.String)
	}
	return v.Encode()
}
