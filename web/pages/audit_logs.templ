package pages

import (
	"database/sql"
	"fmt"
	"net/url"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
)

var auditActionFilterOptions = []string{
	"CREATE",
	"UPDATE",
	"DELETE",
	"BULK_DELETE",
	"IMPORT",
	"BACKUP",
	"RESTORE",
	"STOCK_ADD",
	"STOCK_INC",
	"STOCK_DEC",
	"STOCK_MOVE",
	"STOCK_MERGE",
	"STOCK_REMOVE",
}

var auditEntityFilterOptions = []string{
	"PART",
	"PARTS",
	"STOCK",
	"HARDWARE",
	"WALL",
	"SETTINGS",
	"USER",
	"SYSTEM",
	"PROJECT",
}

templ AuditLogs(user auth.User, logs []db.ListAuditLogsRow, users []db.ListUsersRow, filters db.ListAuditLogsParams, totalCount int64, currentPage int) {
	@layouts.Base(i18n.T(ctx, "AuditLogs"), user) {
		<div class="max-w-7xl mx-auto w-full px-4">
			@components.PageHeader(i18n.T(ctx, "AuditLogs"), i18n.T(ctx, "AuditLogsDescription"), nil)
			<!-- Filters -->
			<div class="card bg-base-200 shadow-sm border border-base-300 mb-6">
				<div class="card-body p-4">
					<form action="/audit-logs" method="GET" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "Search") }</span>
							</label>
							<input type="text" name="search" value={ filters.Search.String } class="input input-bordered input-md w-full" placeholder={ i18n.T(ctx, "SearchDetailsPlaceholder") }/>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "Action") }</span>
							</label>
							<select name="action_type" class="select select-bordered select-md w-full">
								<option value="">{ i18n.T(ctx, "AllActions") }</option>
								for _, action := range auditActionFilterOptions {
									<option value={ action } selected?={ filters.ActionType.String == action }>{ i18n.T(ctx, action) }</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "User") }</span>
							</label>
							<select name="user_id" class="select select-bordered select-md w-full">
								<option value="">{ i18n.T(ctx, "AllUsers") }</option>
								for _, u := range users {
									<option value={ fmt.Sprintf("%d", u.ID) } selected?={ filters.UserID.Valid && filters.UserID.Int64 == u.ID }>{ u.Email }</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "Entity") }</span>
							</label>
							<select name="entity_type" class="select select-bordered select-md w-full">
								<option value="">{ i18n.T(ctx, "AllEntities") }</option>
								for _, entity := range auditEntityFilterOptions {
									<option value={ entity } selected?={ filters.EntityType.String == entity }>{ i18n.T(ctx, entity) }</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "Start Date") }</span>
							</label>
							<input type="date" name="start_date" value={ formatAuditFilterDate(filters.StartDate) } class="input input-bordered input-md w-full"/>
						</div>
						<div class="form-control">
							<label class="label pt-0 pb-1">
								<span class="label-text text-md font-bold uppercase opacity-50">{ i18n.T(ctx, "End Date") }</span>
							</label>
							<input type="date" name="end_date" value={ formatAuditFilterDate(filters.EndDate) } class="input input-bordered input-md w-full"/>
						</div>
						<div class="flex gap-2 lg:col-span-2">
							<button type="submit" class="btn btn-primary btn-md flex-1">{ i18n.T(ctx, "Filter") }</button>
							<a href="/audit-logs" class="btn btn-outline btn-primary btn-md">{ i18n.T(ctx, "Reset") }</a>
						</div>
					</form>
				</div>
			</div>
			<!-- Logs Table -->
			<div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden">
				<div class="overflow-x-auto">
					<table class="table table-zebra w-full">
						<thead>
							<tr class="bg-base-200">
								<th>{ i18n.T(ctx, "Timestamp") }</th>
								<th>{ i18n.T(ctx, "User") }</th>
								<th>{ i18n.T(ctx, "Action") }</th>
								<th>{ i18n.T(ctx, "Entity") }</th>
								<th>{ i18n.T(ctx, "Details") }</th>
								<th class="text-right">{ i18n.T(ctx, "Data") }</th>
							</tr>
						</thead>
						<tbody id="audit-logs-table-body">
							@AuditLogRows(logs, filters, currentPage)
						</tbody>
					</table>
				</div>
			</div>
			<!-- Infinite Scroll Sentinel is inside AuditLogRows -->
		</div>
		@components.AuditDetailModal()
		<script src="/static/js/audit.js"></script>
	}
}

templ AuditLogRows(logs []db.ListAuditLogsRow, filters db.ListAuditLogsParams, currentPage int) {
	for _, log := range logs {
		<tr class="hover">
			<td class="text-xs whitespace-nowrap">
				if log.CreatedAt.Valid {
					{ log.CreatedAt.Time.Format("2006-01-02 15:04:05") }
				}
			</td>
			<td>
				<div class="flex flex-col">
					<span class="text-sm font-medium">{ log.UserEmail.String }</span>
				</div>
			</td>
			<td>
				<span class={ "badge badge-sm font-mono " + getActionBadgeClass(log.ActionType) }>
					{ i18n.T(ctx, log.ActionType) }
				</span>
			</td>
			<td>
				<div class="flex flex-col text-xs">
					<span class="opacity-50">{ i18n.T(ctx, log.EntityType) }</span>
					<span class="font-mono">ID: { fmt.Sprintf("%d", log.EntityID) }</span>
				</div>
			</td>
			<td class="max-w-xs truncate text-sm">
				{ log.Details.String }
			</td>
			<td class="text-right">
				<button
					type="button"
					class="btn btn-ghost btn-xs"
					data-old={ string(log.OldValue) }
					data-new={ string(log.NewValue) }
					{ templ.Attributes{"onclick": fmt.Sprintf("openAuditLogDetail(%d, this.dataset.old, this.dataset.new)", log.ID)}... }
				>
					@icons.Eye(templ.Attributes{"class": "w-5 h-5"})
					{ i18n.T(ctx, "View") }
				</button>
			</td>
		</tr>
	}
	if len(logs) == 0 && currentPage == 1 {
		<tr>
			<td colspan="6" class="text-center py-12 opacity-50">
				{ i18n.T(ctx, "NoAuditLogsFound") }
			</td>
		</tr>
	}
	// Sentinel for infinite scroll
	// If we got a full batch (20), assume there might be more
	if len(logs) >= 20 {
		<tr
			hx-get={ templ.SafeURL(fmt.Sprintf("/audit-logs?page=%d&scroll=true&%s", currentPage+1, getFilterQuery(filters))) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
		>
			<td colspan="6" class="text-center py-4">
				<span class="loading loading-dots loading-md opacity-50"></span>
			</td>
		</tr>
	}
}

func formatAuditFilterDate(t sql.NullTime) string {
	if !t.Valid {
		return ""
	}
	return t.Time.UTC().Format("2006-01-02")
}

func getActionBadgeClass(action string) string {
	switch action {
	case "CREATE", "IMPORT", "STOCK_ADD", "STOCK_INC":
		return "badge-success"
	case "UPDATE", "BACKUP", "STOCK_MOVE", "STOCK_MERGE":
		return "badge-info"
	case "DELETE", "BULK_DELETE", "STOCK_REMOVE":
		return "badge-error"
	case "RESTORE", "STOCK_DEC", "ADJUST_STOCK":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}

func getFilterQuery(f db.ListAuditLogsParams) string {
	v := url.Values{}
	if f.ActionType.Valid && f.ActionType.String != "" {
		v.Set("action_type", f.ActionType.String)
	}
	if f.EntityType.Valid && f.EntityType.String != "" {
		v.Set("entity_type", f.EntityType.String)
	}
	if f.UserID.Valid {
		v.Set("user_id", fmt.Sprintf("%d", f.UserID.Int64))
	}
	if f.Search.Valid && f.Search.String != "" {
		v.Set("search", f.Search.String)
	}
	if f.StartDate.Valid {
		v.Set("start_date", f.StartDate.Time.UTC().Format("2006-01-02"))
	}
	if f.EndDate.Valid {
		v.Set("end_date", f.EndDate.Time.UTC().Format("2006-01-02"))
	}
	return v.Encode()
}
