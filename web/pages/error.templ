package pages

import (
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/layouts"
	"strconv"
)

templ ErrorPage(user auth.User, message string, code int) {
	@layouts.Base(i18n.T(ctx, "Error"), user) {
		<div class="flex flex-col items-center justify-center h-[60vh] text-center px-4">
			<div class="mb-6">
				<div class="text-9xl font-bold opacity-10 mb-2">{ strconv.Itoa(code) }</div>
				<h1 class="text-3xl font-bold mb-2">{ i18n.T(ctx, "OopsSomethingWentWrong") }</h1>
				<p class="text-base-content/60 max-w-md mx-auto">
					{ message }
				</p>
			</div>
			<div class="flex gap-4">
				<a href="/" class="btn btn-primary">{ i18n.T(ctx, "GoToDashboard") }</a>
				<button onclick="window.history.back()" class="btn btn-ghost">{ i18n.T(ctx, "GoBack") }</button>
			</div>
		</div>
	}
}

templ ErrorPartial(message string) {
	<div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 5000)" class="alert alert-error shadow-lg mb-4 animate-in fade-in slide-in-from-top duration-300">
		<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
		<span>{ message }</span>
		<button @click="show = false" class="btn btn-ghost btn-xs btn-square">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
		</button>
	</div>
}