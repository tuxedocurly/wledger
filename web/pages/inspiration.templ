package pages

import (
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ Inspiration(templates []db.InspirationTemplate, allTags []string, user auth.User) {
	@layouts.Base("Inspiration", user) {
		@components.PageHeader("Inspiration", "Create AI prompts for your inventory. Get inspired or save commonly used prompts.", nil)
		<div x-data="inspirationApp" class="space-y-6">
			<div class="flex flex-col md:flex-row justify-end mb-6 gap-4">
				if user.CanWrite() {
					<button
						hx-get="/inspiration/new"
						hx-target="body"
						hx-swap="beforeend"
						class="btn btn-primary gap-2"
					>
						@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
						Add Prompt
					</button>
				}
			</div>
			<!-- Part Tag Filter -->
			<div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow border border-base-300">
				<div class="card-body p-4">
					<div class="flex flex-col gap-2">
						<div class="flex flex-wrap items-center gap-2">
							<span class="font-semibold text-sm uppercase tracking-wider text-gray-500">Context Filter:</span>
							<span x-show="selectedTags.length === 0" class="badge badge-primary badge-sm">Entire Inventory</span>
							<template x-for="tag in selectedTags" :key="tag">
								<span class="badge badge-primary badge-sm gap-1">
									<span x-text="tag"></span>
									<button @click="toggleTag(tag)" class="hover:text-white/80">
										@icons.X(templ.Attributes{"class": "w-4 h-4"})
									</button>
								</span>
							</template>
							<span x-show="selectedTags.length > 0" class="text-xs text-gray-400 cursor-pointer hover:text-gray-600" @click="selectedTags = []">Clear</span>
						</div>
						<!-- Horizontal Scroll Tag List -->
						<div class="flex gap-2 overflow-x-auto pb-2 pt-1 no-scrollbar mask-linear-fade">
							for _, tag := range allTags {
								<button
									data-tag={ tag }
									@click="toggleTag($el.dataset.tag)"
									x-show="!selectedTags.includes($el.dataset.tag)"
									class="btn btn-outline btn-secondary btn-xs rounded-full normal-case whitespace-nowrap"
								>{ tag }</button>
							}
							if len(allTags) == 0 {
								<span class="text-sm text-gray-400 italic">No tags found in inventory.</span>
							}
						</div>
					</div>
				</div>
			</div>
			<!-- Templates Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				for _, t := range templates {
					@components.InspirationCard(t, user.CanWrite())
				}
			</div>
			<script src="/static/js/inspiration.js"></script>
		</div>
	}
}
