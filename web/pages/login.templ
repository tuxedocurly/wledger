package pages

import "github.com/tuxedocurly/wledger/internal/i18n"

templ Login(errorMessage string, allowGuest bool) {
	<!DOCTYPE html>
	<html data-theme="dark" lang={ i18n.GetLanguage(ctx) }>
		<head>
			<title>WLEDger - { i18n.T(ctx, "Login") }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/img/favicon.ico"/>
			<link href="/static/css/output.css" rel="stylesheet"/>
		</head>
		<body class="bg-base-300 min-h-screen flex items-center justify-center">
			<div class="card w-full max-w-sm bg-base-100 shadow-xl">
				<div class="card-body">
					<div class="text-center mb-6">
						<div class="flex justify-center mb-2">
							<img src="/static/img/wledger-name-rainbow.png" alt="WLEDger" class="h-10 w-auto object-contain"/>
						</div>
						<p class="text-xs opacity-50 uppercase tracking-widest mt-1">{ i18n.T(ctx, "InventoryAndControl") }</p>
					</div>
					if errorMessage != "" {
						<div class="alert alert-error text-sm py-2 rounded-md mb-4 flex items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>{ errorMessage }</span>
						</div>
					}
					<form action="/login" method="POST" class="space-y-4">
						<div class="form-control">
							<label class="label">
								<span class="label-text">{ i18n.T(ctx, "Email") }</span>
							</label>
							<input type="email" name="email" placeholder="email@example.com" class="input input-bordered" required/>
						</div>
						<div class="form-control">
							<label class="label">
								<span class="label-text">{ i18n.T(ctx, "Password") }</span>
							</label>
							<input type="password" name="password" placeholder="••••••••" class="input input-bordered" required/>
						</div>
						<div class="form-control mt-6">
							<button class="btn btn-primary btn-block">{ i18n.T(ctx, "Login") }</button>
						</div>
					</form>
					if allowGuest {
						<div class="divider text-xs opacity-50">{ i18n.T(ctx, "OR") }</div>
						<a href="/" class="btn btn-outline btn-block gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
							{ i18n.T(ctx, "ContinueAsGuest") }
						</a>
					}
					<div class="text-center mt-4">
						<p class="text-xs opacity-40">WLEDger V2.0</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}