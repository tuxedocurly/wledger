package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
	"strings"
)

templ PartDetail(user auth.User, part db.Part, stock []db.GetPartAssignmentsRow, links []db.PartLink, docs []db.PartDoc, controllers []db.Controller) {
	@layouts.Base(part.Name, user) {
		<div class="max-w-5xl mx-auto w-full">
			@components.PageHeader(
				part.Name,
				part.Description.String,
				[]components.Breadcrumb{
					{Label: i18n.T(ctx, "Inventory"), URL: "/parts"},
					{Label: part.Name},
				},
			) {
				if user.CanWrite() {
					<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d/clone", part.ID)) } class="btn btn-outline gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
						{ i18n.T(ctx, "ClonePart") }
					</a>
					<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d/edit", part.ID)) } class="btn btn-outline gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
						{ i18n.T(ctx, "EditPart") }
					</a>
					@components.DeleteButton(components.DeleteButtonProps{
						ID:          fmt.Sprintf("%d", part.ID),
						TargetURL:   fmt.Sprintf("/parts/%d/delete", part.ID),
						Message:     i18n.T(ctx, "ConfirmDeletePart"),
						ButtonLabel: i18n.T(ctx, "Delete"),
					})
				}
			}
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<div class="space-y-6">
					<div class="card bg-base-200 shadow-xl border border-base-300 overflow-hidden">
						<figure class="aspect-square bg-base-300 relative group">
							if part.ImagePath.Valid && part.ImagePath.String != "" {
								<img src={ part.ImagePath.String } alt={ part.Name } class="w-full h-full object-cover"/>
							} else {
								<div class="flex flex-col items-center justify-center h-full opacity-20">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								</div>
							}
						</figure>
					</div>
					<div class="card bg-base-200 shadow-xl border border-base-300">
						<div class="card-body p-4">
							<h3 class="font-bold text-xs uppercase tracking-wider opacity-50 mb-3">{ i18n.T(ctx, "Specifications") }</h3>
							<div class="space-y-3 text-sm">
								if part.PartNumber.Valid && part.PartNumber.String != "" {
									<div class="flex justify-between">
										<span class="opacity-70">{ i18n.T(ctx, "MPN") }</span>
										<span class="font-mono">{ part.PartNumber.String }</span>
									</div>
								}
								if part.Manufacturer.Valid && part.Manufacturer.String != "" {
									<div class="flex justify-between">
										<span class="opacity-70">{ i18n.T(ctx, "Manufacturer") }</span>
										<span class="font-medium">{ part.Manufacturer.String }</span>
									</div>
								}
								if part.Supplier.Valid && part.Supplier.String != "" {
									<div class="flex justify-between">
										<span class="opacity-70">{ i18n.T(ctx, "Supplier") }</span>
										<span class="font-medium">{ part.Supplier.String }</span>
									</div>
								}
								if part.BarcodeData.Valid && part.BarcodeData.String != "" {
									<div class="flex justify-between">
										<span class="opacity-70">{ i18n.T(ctx, "Barcode") }</span>
										<span class="font-mono">{ part.BarcodeData.String }</span>
									</div>
								}
								<div class="divider"></div>
								<div class="flex justify-between">
									<span class="opacity-70">{ i18n.T(ctx, "UnitCost") }</span>
									<span class="font-mono">$ { fmt.Sprintf("%.2f", part.UnitCost.Float64) }</span>
								</div>
								if part.Tags.Valid && part.Tags.String != "" {
									<div class="divider"></div>
									<span class="flex justify-between opacity-70">{ i18n.T(ctx, "Tags") }</span>
									<div class="flex flex-wrap gap-1">
										for tag := range strings.SplitSeq(part.Tags.String, ", ") {
											<span class="badge badge-info badge-outline badge-sm">{ tag }</span>
										}
									</div>
								}
							</div>
						</div>
					</div>
					if len(links) > 0 || len(docs) > 0 {
						<div class="card bg-base-200 shadow-xl border border-base-300">
							<div class="card-body p-4">
								<h3 class="font-bold text-xs uppercase tracking-wider opacity-50 mb-3">{ i18n.T(ctx, "Resources") }</h3>
								if len(links) > 0 {
									<div class="flex flex-col gap-2">
										for _, link := range links {
											<a href={ templ.SafeURL(link.Url) } target="_blank" class="btn btn-sm btn-ghost justify-start font-normal h-auto py-2">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
												{ link.Label.String }
											</a>
										}
									</div>
								}
								if len(links) > 0 && len(docs) > 0 {
									<div class="divider my-1"></div>
								}
								if len(docs) > 0 {
									<div class="flex flex-col gap-2">
										for _, doc := range docs {
											<a href={ templ.SafeURL(doc.FilePath) } target="_blank" class="btn btn-sm btn-ghost justify-start font-normal h-auto py-2">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
												{ doc.FileName }
											</a>
										}
									</div>
								}
							</div>
						</div>
					}
				</div>
				<div class="lg:col-span-2 space-y-6">
					<div class="stats shadow-xl border border-base-300 w-full bg-base-200">
						<div class="stat">
							<div class="stat-title">{ i18n.T(ctx, "TotalInStock") }</div>
							<div class="stat-value text-primary">
								{ fmt.Sprintf("%d", calculateTotalStock(stock)) }
							</div>
							if part.MinStockThreshold.Valid && calculateTotalStock(stock) <= part.MinStockThreshold.Int64 {
								<div class="stat-desc text-warning font-bold">{ i18n.T(ctx, "LowStockWarning") }</div>
							}
						</div>
					</div>
					<div class="card bg-base-200 shadow-xl border border-base-300">
						<div class="card-body p-0">
							<div class="p-4 border-b border-base-300 flex justify-between items-center">
								<h3 class="font-bold">{ i18n.T(ctx, "Locations") }</h3>
								if user.CanWrite() {
									<button onclick="stock_modal.showModal()" class="btn btn-sm btn-primary">
										@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
										{ i18n.T(ctx, "AddStock") }
									</button>
								}
							</div>
							<div class="overflow-x-auto">
								<table class="table">
									<thead>
										<tr>
											<th>{ i18n.T(ctx, "Location") }</th>
											<th>{ i18n.T(ctx, "Hardware") }</th>
											<th>{ i18n.T(ctx, "Qty") }</th>
											<th class="text-right w-1">{ i18n.T(ctx, "Actions") }</th>
										</tr>
									</thead>
									<tbody>
										if len(stock) == 0 {
											<tr>
												<td colspan="4" class="text-center py-8 opacity-50">
													{ i18n.T(ctx, "NoStockAssigned") }
												</td>
											</tr>
										}
										for _, s := range stock {
											@StockRow(part.ID, s, user, controllers)
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
			if user.CanWrite() {
				@components.Modal(components.ModalProps{
					ID:       "stock_modal",
					Title:    i18n.T(ctx, "AddStockLocation"),
					BoxClass: "bg-base-100 max-w-2xl",
				}) {
					<form
						action={ templ.SafeURL(fmt.Sprintf("/parts/%d/assign", part.ID)) }
						method="POST"
						class="space-y-6"
						x-data="{ hasSelection: false }"
					>
						<div class="form-control w-full">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-bold text-xs uppercase tracking-widest">{ i18n.T(ctx, "SelectWLEDController") }</span>
							</label>
							<select
								name="controller_id"
								class="select select-bordered w-full"
								hx-get="/parts/bin_picker"
								hx-target="#visual_bin_picker"
								hx-trigger="change"
								required
								@change="hasSelection = false"
							>
								<option value="" disabled selected>{ i18n.T(ctx, "SelectAController") }</option>
								for _, c := range controllers {
									<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
								}
							</select>
						</div>
						<div class="form-control w-full">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-bold text-xs uppercase tracking-widest">{ i18n.T(ctx, "ChoosePhysicalBin") }</span>
							</label>
							<div
								id="visual_bin_picker"
								class="min-h-[200px] flex items-center justify-center border-2 border-dashed border-base-300 rounded-xl bg-base-200/30"
								@bin-selected-form="hasSelection = true"
							>
								<div class="text-center opacity-40 py-8">
									<p class="text-sm">{ i18n.T(ctx, "SelectControllerPrompt") }</p>
								</div>
							</div>
						</div>
						<div class="divider"></div>
						<div class="form-control w-full" x-data="{ qty: 1 }">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-bold text-xs uppercase tracking-widest">{ i18n.T(ctx, "SetQuantity") }</span>
							</label>
							<div class="join w-full">
								<button
									type="button"
									class="btn btn-primary join-item btn-square"
									@click="qty = Math.max(1, parseInt(qty || 0) - 1)"
								>
									@icons.Minus(templ.Attributes{"class": "w-5 h-5"})
								</button>
								<input
									type="number"
									name="quantity"
									x-model="qty"
									min="1"
									class="input input-bordered join-item w-full text-center font-mono font-bold"
									required
								/>
								<button
									type="button"
									class="btn btn-primary join-item btn-square"
									@click="qty = parseInt(qty || 0) + 1"
								>
									@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
								</button>
							</div>
						</div>
						<div class="modal-action mt-8 pt-6 border-t border-base-200">
							<button type="button" class="btn btn-ghost" onclick="stock_modal.close()">{ i18n.T(ctx, "Cancel") }</button>
							<button type="submit" class="btn btn-primary px-8" :disabled="!hasSelection">{ i18n.T(ctx, "SaveStock") }</button>
						</div>
					</form>
				}
			}
		</div>
	}
}

templ StockRow(partID int64, s db.GetPartAssignmentsRow, user auth.User, controllers []db.Controller) {
	<tr>
		<td class="font-medium">
			if s.BinName.Valid {
				<div class="flex items-center gap-2">
					@icons.MapPin(templ.Attributes{"class": "w-5 h-5"})
					{ s.BinName.String }
				</div>
			} else {
				<div class="flex items-center gap-2 text-warning" title={ i18n.T(ctx, "OrphanedStockTitle") }>
					@icons.TriangleAlert(templ.Attributes{"class": "w-5 h-5"})
					{ i18n.T(ctx, "Orphaned") }
				</div>
			}
		</td>
		<td class="text-sm opacity-70">
			if s.ControllerName.Valid {
				{ s.ControllerName.String }
			} else {
				<span class="italic">{ i18n.T(ctx, "Unmanaged") }</span>
			}
		</td>
		<td class="text-right font-mono font-bold">
			if user.CanWrite() {
				<div class="flex items-center gap-2">
					<button
						hx-post={ fmt.Sprintf("/parts/%d/stock/%d/adjust?delta=-1", partID, s.ID) }
						hx-target="closest tr"
						hx-swap="outerHTML"
						class="btn btn-xs btn-circle btn-primary"
					>
						@icons.Minus(templ.Attributes{"class": "w-4 h-4"})
					</button>
					<span>{ fmt.Sprintf("%d", s.Quantity) }</span>
					<button
						hx-post={ fmt.Sprintf("/parts/%d/stock/%d/adjust?delta=1", partID, s.ID) }
						hx-target="closest tr"
						hx-swap="outerHTML"
						class="btn btn-xs btn-circle btn-primary"
					>
						@icons.Plus(templ.Attributes{"class": "w-4 h-4"})
					</button>
				</div>
			} else {
				{ fmt.Sprintf("%d", s.Quantity) }
			}
		</td>
		<td class="text-right">
			<div class="flex justify-end gap-1">
				if s.ControllerID.Valid && s.BinID.Valid {
					@components.LocateButton(s.ControllerID.Int64, s.BinID.Int64, "btn-xs")
				}
				if user.CanWrite() {
					if !s.BinName.Valid || !s.ControllerID.Valid {
						<button
							{ templ.Attributes{"onclick": fmt.Sprintf("move_stock_modal_%d.showModal()", s.ID)}... }
							class="btn btn-xs btn-outline btn-warning"
							title={ i18n.T(ctx, "ReassignToValidBin") }
						>
							{ i18n.T(ctx, "Fix") }
						</button>
						@components.MoveStockModal(
							fmt.Sprintf("move_stock_modal_%d", s.ID),
							i18n.T(ctx, "ReassignOrphanedStock"),
							i18n.TD(ctx, "ReassignOrphanedStockDesc", map[string]interface{}{"Count": s.Quantity}),
							fmt.Sprintf("/parts/%d/stock/%d/move", partID, s.ID),
							s.Quantity,
							controllers,
						)
					} else {
						<button
							{ templ.Attributes{"onclick": fmt.Sprintf("move_stock_modal_%d.showModal()", s.ID)}... }
							class="btn btn-xs btn-ghost"
							title={ i18n.T(ctx, "MoveStock") }
						>
							@icons.ArrowRightLeft(templ.Attributes{"class": "w-5 h-5"})
						</button>
						@components.MoveStockModal(
							fmt.Sprintf("move_stock_modal_%d", s.ID),
							i18n.T(ctx, "MoveStock"),
							i18n.TD(ctx, "MoveStockDesc", map[string]interface{}{"Count": s.Quantity}),
							fmt.Sprintf("/parts/%d/stock/%d/move", partID, s.ID),
							s.Quantity,
							controllers,
						)
					                                        }
					                                        <form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/stock/%d/delete", partID, s.ID)) } method="POST" { templ.Attributes{"onsubmit": fmt.Sprintf("return confirm('%s');", i18n.T(ctx, "ConfirmRemoveStock"))}... }>
					                                                <button class="btn btn-xs btn-ghost text-error" title={ i18n.T(ctx, "Remove") }>
					                                                        @icons.Trash(templ.Attributes{"class": "w-5 h-5"})
					                                                </button>
					                                        </form>
					                                }
					                        </div>
					                </td>
					        </tr>
					}
// Helper to sum stock
func calculateTotalStock(stock []db.GetPartAssignmentsRow) int64 {
	var total int64 = 0
	for _, s := range stock {
		total += s.Quantity
	}
	return total
}