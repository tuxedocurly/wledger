package pages

import (
	"database/sql"
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/config"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
	"net/url"
	"os"
	"path"
	"path/filepath"
	"strings"
)

type PartView struct {
	ID            int64
	Name          string
	Description   sql.NullString
	PartNumber    sql.NullString
	ImagePath     sql.NullString
	IsFavorite    sql.NullBool
	UnitCost      sql.NullFloat64
	TotalStock    int64
	ValidStock    int64
	OrphanedStock int64
}

// PartsList is the full page wrapper
templ PartsList(user auth.User, parts []PartView, search string, page int, binID *int64, filters ...components.PartSearchFilters) {
	@layouts.Base(i18n.T(ctx, "Inventory"), user) {
		<div
			x-data="{ 
                                selectedIds: [], 
                                toggleSelection(id) {
                                        if (this.selectedIds.includes(id)) {
                                                this.selectedIds = this.selectedIds.filter(i => i !== id);
                                        } else {
                                                this.selectedIds.push(id);
                                        }
                                },
                                selectAll() {
                                        const checkboxes = document.querySelectorAll('.part-checkbox');
                                        const allIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
                                        this.selectedIds = [...new Set([...this.selectedIds, ...allIds])];
                                },
                                deselectAll() {
                                        this.selectedIds = [];
                                }
                        }"
		>
			@components.PageHeader(i18n.T(ctx, "Inventory"), "", nil)
			<div class="flex flex-col md:flex-row justify-end items-center mb-6 gap-4">
				<div x-show="selectedIds.length === 0" class="w-full md:w-auto">
					@components.PartSearchBar(search, user.CanWrite(), filters...)
				</div>
				<div x-show="selectedIds.length > 0" class="w-full" x-cloak>
					<!-- Bulk Toolbar -->
					<div class="flex flex-col sm:flex-row items-center justify-between bg-base-200 p-2 rounded-lg border border-primary/30 gap-3">
						<div class="flex items-center justify-between w-full sm:w-auto gap-4">
							<span class="text-sm font-bold ml-2"><span x-text="selectedIds.length"></span> { i18n.T(ctx, "ItemsSelected") }</span>
							<button class="btn btn-md btn-outline" @click="deselectAll()">{ i18n.T(ctx, "Cancel") }</button>
						</div>
						<div class="flex gap-2 w-full sm:w-auto">
							<button class="btn btn-md btn-primary flex-1 sm:flex-none" @click="selectAll()">{ i18n.T(ctx, "SelectAllVisible") }</button>
							if user.CanWrite() {
								<button class="btn btn-md btn-error flex-1 sm:flex-none" @click="document.getElementById('bulk_delete_modal').showModal()">{ i18n.T(ctx, "Delete") }</button>
							}
						</div>
					</div>
				</div>
			</div>
			<div id="parts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-12 items-stretch">
				if len(parts) == 0 && page == 1 {
					@components.EmptyState(i18n.T(ctx, "NoPartsFound"), i18n.TD(ctx, "NoPartsMatching", map[string]interface{}{"Search": search}), "📦") {
						if search != "" {
							<button onclick="document.querySelector('input[name=q]').value = ''; htmx.trigger('input[name=q]', 'input');" class="btn btn-sm btn-outline mt-4">
								{ i18n.T(ctx, "ClearSearch") }
							</button>
						}
					}
				} else {
					@PartCards(parts, search, page, binID, filters...)
				}
			</div>
			@components.ImportModal()
			if user.CanWrite() {
				@components.Modal(components.ModalProps{ID: "bulk_delete_modal", Title: i18n.T(ctx, "ConfirmBulkDelete"), TitleClass: "text-error"}) {
					<p class="py-4">
						{ i18n.T(ctx, "BulkDeleteConfirmPrefix") } <span class="font-bold" x-text="selectedIds.length"></span> { i18n.T(ctx, "BulkDeleteConfirmSuffix") }
					</p>
					<div class="modal-action">
						<form method="dialog">
							<button class="btn">{ i18n.T(ctx, "Cancel") }</button>
						</form>
						<button
							class="btn btn-error"
							@click="htmx.ajax('DELETE', '/parts/bulk', { values: { ids: selectedIds }, target: '#main-content' }); document.getElementById('bulk_delete_modal').close()"
						>
							{ i18n.T(ctx, "ConfirmDelete") }
						</button>
					</div>
				}
			}
		</div>
	}
}

// TODO: refactor into a standalone component
templ PartCards(parts []PartView, search string, page int, binID *int64, filters ...components.PartSearchFilters) {
	// Render the cards
	for _, part := range parts {
		<div
			onclick={ navigateTo(fmt.Sprintf("/parts/%d", part.ID)) }
			class="card bg-base-200 shadow-xl hover:shadow-2xl hover:z-50 transition-all cursor-pointer flex flex-col h-full group relative"
		>
			<div class="absolute top-2 left-2 z-30" @click.stop>
				<input
					type="checkbox"
					class="checkbox checkbox-primary part-checkbox border-2 border-primary/50 bg-base-100/50 backdrop-blur-sm"
					value={ fmt.Sprintf("%d", part.ID) }
					:checked={ fmt.Sprintf("selectedIds.includes(%d)", part.ID) }
					@change={ fmt.Sprintf("toggleSelection(%d)", part.ID) }
				/>
			</div>
			<figure class="h-48 shrink-0 bg-base-300 relative overflow-hidden">
				if part.ImagePath.Valid && part.ImagePath.String != "" {
					<img
						src={ ImageThumbURL(part.ImagePath.String) }
						alt={ part.Name }
						class="object-cover w-full h-full transform transition-transform duration-500 group-hover:scale-110"
					/>
				} else {
					<div class="flex items-center justify-center w-full h-full text-4xl opacity-30 transform transition-transform duration-500 group-hover:scale-110 grayscale">📷</div>
				}
			</figure>
			<div class="card-body p-4 relative z-10 bg-base-200 flex-1 flex flex-col min-w-0">
				<h2 class="card-title text-base items-start justify-between gap-2 min-h-[3rem]">
					<span class="line-clamp-2 break-words min-w-0" title={ part.Name }>
						{ part.Name }
					</span>
					if part.IsFavorite.Bool {
						<span class="text-warning text-xs shrink-0 mt-1">★</span>
					}
				</h2>
				<div x-data="{ isClamped: false, showPopup: false }" class="relative" @mouseleave="showPopup = false">
					<div
						class="line-clamp-2 min-h-[2.5rem] break-words"
						@mouseenter="$el.scrollHeight > $el.clientHeight ? (isClamped = true, showPopup = true) : (isClamped = false)"
					>
						<p class="text-sm opacity-70">{ part.Description.String }</p>
					</div>
					<div
						x-show="showPopup && isClamped"
						x-cloak
						x-transition.opacity
						class="absolute top-2 left-2 right-2 z-40 bg-base-contrast p-3 border border-base-contrast shadow-xl rounded-lg max-h-40 overflow-y-auto"
						@click.stop
					>
						<p class="text-sm">{ part.Description.String }</p>
					</div>
				</div>
				<div class="flex justify-between items-end gap-2 mt-auto pt-3">
					<div class="flex flex-col min-w-0 flex-1">
						if part.PartNumber.Valid && part.PartNumber.String != "" {
							<span class="text-sm font-mono opacity-50 truncate block h-5" title={ part.PartNumber.String }># { part.PartNumber.String }</span>
						} else {
							<span class="text-sm font-mono opacity-50 block h-5"></span>
						}
						<span class="badge badge-info font-semibold mt-1 shrink-0">{ i18n.T(ctx, "Stock") }: { fmt.Sprintf("%d", part.TotalStock) }</span>
					</div>
					<div class="flex items-center gap-2 shrink-0">
						if part.OrphanedStock > 0 {
							@components.OrphanedStockWarning()
						}
						if part.ValidStock > 0 {
							@components.PartLocateButton(part.ID, "btn-sm")
						}
					</div>
				</div>
			</div>
		</div>
	}
	// sentinel for loading more parts
	if len(parts) >= 20 {
		<div
			hx-get={ partsScrollURL(page+1, search, binID, filters...) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
			class="col-span-full h-12 w-full flex justify-center items-center opacity-50 text-xs"
		>
			<span class="loading loading-dots loading-lg text-primary"></span>
		</div>
	}
}

// ImageThumbURL returns the thumbnail web path (<base>_thumb.jpg) when
// imagePath references an uploaded file whose thumbnail exists on disk, or
// falls back to imagePath otherwise.
func ImageThumbURL(imagePath string) string {
	if imagePath == "" || !strings.HasPrefix(imagePath, config.UrlPrefixUploads) {
		return imagePath
	}
	ext := path.Ext(imagePath)
	if ext == "" {
		return imagePath
	}
	base := strings.TrimSuffix(imagePath, ext)
	if strings.HasSuffix(base, "_thumb") {
		return imagePath
	}
	thumbWebPath := base + "_thumb.jpg"
	relPath := strings.TrimPrefix(thumbWebPath, config.UrlPrefixUploads)
	diskPath := filepath.Join(config.DirUploads, filepath.FromSlash(relPath))
	info, err := os.Stat(diskPath)
	if err != nil || info.IsDir() {
		return imagePath
	}
	return thumbWebPath
}

func partsScrollURL(page int, search string, binID *int64, filters ...components.PartSearchFilters) string {
	vals := url.Values{}
	vals.Set("page", fmt.Sprintf("%d", page))
	vals.Set("q", search)
	vals.Set("scroll", "true")
	var f components.PartSearchFilters
	if len(filters) > 0 {
		f = filters[0]
	}
	if f.Bin != "" {
		vals.Set("bin", f.Bin)
	} else if f.BinID != "" {
		vals.Set("bin_id", f.BinID)
	} else if binID != nil {
		vals.Set("bin", fmt.Sprintf("%d", *binID))
	}
	if f.Tag != "" {
		vals.Set("tag", f.Tag)
	}
	if f.ControllerID != "" {
		vals.Set("controller_id", f.ControllerID)
	}
	if f.Stock != "" {
		vals.Set("stock", f.Stock)
	}
	if f.Sort != "" {
		vals.Set("sort", f.Sort)
	}
	return "/parts?" + vals.Encode()
}

script navigateTo(url string) {
        window.location.href = url;
}
