package pages

import (
	"database/sql"
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
	"net/url"
)

type PartView struct {
	ID            int64
	Name          string
	Description   sql.NullString
	PartNumber    sql.NullString
	ImagePath     sql.NullString
	IsFavorite    sql.NullBool
	UnitCost      sql.NullFloat64
	TotalStock    int64
	ValidStock    int64
	OrphanedStock int64
}

// PartsList is the full page wrapper
templ PartsList(user auth.User, parts []PartView, search string, page int, binID *int64) {
	@layouts.Base(i18n.T(ctx, "Inventory"), user) {
		<div
			x-data="{ 
                                selectedIds: [], 
                                toggleSelection(id) {
                                        if (this.selectedIds.includes(id)) {
                                                this.selectedIds = this.selectedIds.filter(i => i !== id);
                                        } else {
                                                this.selectedIds.push(id);
                                        }
                                },
                                selectAll() {
                                        const checkboxes = document.querySelectorAll('.part-checkbox');
                                        const allIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
                                        this.selectedIds = [...new Set([...this.selectedIds, ...allIds])];
                                },
                                deselectAll() {
                                        this.selectedIds = [];
                                }
                        }"
		>
			@components.PageHeader(i18n.T(ctx, "Inventory"), "", nil)
			<div class="flex flex-col md:flex-row justify-end items-center mb-6 gap-4">
				<div x-show="selectedIds.length === 0" class="w-full md:w-auto">
					@components.PartSearchBar(search, user.CanWrite())
				</div>
				<div x-show="selectedIds.length > 0" class="w-full" x-cloak>
					<!-- Bulk Toolbar -->
					<div class="flex flex-col sm:flex-row items-center justify-between bg-base-200 p-2 rounded-lg border border-primary/30 gap-3">
						<div class="flex items-center justify-between w-full sm:w-auto gap-4">
							<span class="text-sm font-bold ml-2"><span x-text="selectedIds.length"></span> { i18n.T(ctx, "ItemsSelected") }</span>
							<button class="btn btn-md btn-outline" @click="deselectAll()">{ i18n.T(ctx, "Cancel") }</button>
						</div>
						<div class="flex gap-2 w-full sm:w-auto">
							<button class="btn btn-md btn-primary flex-1 sm:flex-none" @click="selectAll()">{ i18n.T(ctx, "SelectAllVisible") }</button>
							if user.CanWrite() {
								<button class="btn btn-md btn-error flex-1 sm:flex-none" @click="document.getElementById('bulk_delete_modal').showModal()">{ i18n.T(ctx, "Delete") }</button>
							}
						</div>
					</div>
				</div>
			</div>
			<div id="parts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-12 items-start">
				if len(parts) == 0 && page == 1 {
					@components.EmptyState(i18n.T(ctx, "NoPartsFound"), i18n.TD(ctx, "NoPartsMatching", map[string]interface{}{"Search": search}), "📦") {
						if search != "" {
							<button onclick="document.querySelector('input[name=q]').value = ''; htmx.trigger('input[name=q]', 'input');" class="btn btn-sm btn-outline mt-4">
								{ i18n.T(ctx, "ClearSearch") }
							</button>
						}
					}
				} else {
					@PartCards(parts, search, page, binID)
				}
			</div>
			@components.ImportModal()
			if user.CanWrite() {
				@components.Modal(components.ModalProps{ID: "bulk_delete_modal", Title: i18n.T(ctx, "ConfirmBulkDelete"), TitleClass: "text-error"}) {
					<p class="py-4">
						{ i18n.T(ctx, "BulkDeleteConfirmPrefix") } <span class="font-bold" x-text="selectedIds.length"></span> { i18n.T(ctx, "BulkDeleteConfirmSuffix") }
					</p>
					<div class="modal-action">
						<form method="dialog">
							<button class="btn">{ i18n.T(ctx, "Cancel") }</button>
						</form>
						<button
							class="btn btn-error"
							@click="htmx.ajax('DELETE', '/parts/bulk', { values: { ids: selectedIds }, target: '#main-content' }); document.getElementById('bulk_delete_modal').close()"
						>
							{ i18n.T(ctx, "ConfirmDelete") }
						</button>
					</div>
				}
			}
		</div>
	}
}

templ PartCards(parts []PartView, search string, page int, binID *int64) {
	// Render the cards
	for _, part := range parts {
		<div
			onclick={ navigateTo(fmt.Sprintf("/parts/%d", part.ID)) }
			class="card bg-base-200 shadow-xl hover:shadow-2xl hover:z-50 transition-all cursor-pointer block group relative"
		>
			<div class="absolute top-2 left-2 z-30" @click.stop>
				<input
					type="checkbox"
					class="checkbox checkbox-primary part-checkbox border-2 border-primary/50 bg-base-100/50 backdrop-blur-sm"
					value={ fmt.Sprintf("%d", part.ID) }
					:checked={ fmt.Sprintf("selectedIds.includes(%d)", part.ID) }
					@change={ fmt.Sprintf("toggleSelection(%d)", part.ID) }
				/>
			</div>
			<figure class="h-48 bg-base-300 relative overflow-hidden">
				if part.ImagePath.Valid && part.ImagePath.String != "" {
					<img
						src={ part.ImagePath.String }
						alt={ part.Name }
						class="object-cover w-full h-full transform transition-transform duration-500 group-hover:scale-110"
					/>
				} else {
					<div class="flex items-center justify-center w-full h-full text-4xl opacity-30 transform transition-transform duration-500 group-hover:scale-110 grayscale">📷</div>
				}
			</figure>
			<div class="card-body p-4 relative z-10 bg-base-200">
				<h2 class="card-title text-base justify-between">
					<span>
						{ part.Name }
						if part.IsFavorite.Bool {
							<span class="text-warning text-xs ml-1">★</span>
						}
					</span>
				</h2>
				<p class="text-xs opacity-70 truncate">{ part.Description.String }</p>
				<div class="flex justify-between items-end mt-4">
					<div class="flex flex-col">
						<span class="text-s font-mono opacity-50"># { part.PartNumber.String }</span>
						<span class="badge badge-info font-semibold mt-1">{ i18n.T(ctx, "Stock") }: { fmt.Sprintf("%d", part.TotalStock) }</span>
					</div>
					<div class="flex items-center gap-2">
						if part.OrphanedStock > 0 {
							@components.OrphanedStockWarning()
						}
						if part.ValidStock > 0 {
							@components.PartLocateButton(part.ID, "btn-sm")
						}
					</div>
				</div>
			</div>
		</div>
	}
	// sentinel for loading more parts
	if len(parts) >= 20 {
		<div
			hx-get={ fmt.Sprintf("/parts?page=%d&q=%s&scroll=true%s", page+1, url.QueryEscape(search), binQuery(binID)) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
			class="col-span-full h-12 w-full flex justify-center items-center opacity-50 text-xs"
		>
			<span class="loading loading-dots loading-lg text-primary"></span>
		</div>
	}
}

func binQuery(binID *int64) string {
	if binID == nil {
		return ""
	}
	return fmt.Sprintf("&bin=%d", *binID)
}

script navigateTo(url string) {
        window.location.href = url;
}